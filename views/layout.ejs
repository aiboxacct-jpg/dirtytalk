<!-- Shared page shell; express-ejs-layouts injects the page body below. -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title><%= typeof title !== 'undefined' ? title + ' · ' + siteName : siteName %></title>
<link rel="stylesheet" href="/public/style.css">
<script>
// Bell chime for pings / new private messages — synthesized (no asset needed).
window.playBell = function () {
  try {
    var now = Date.now();
    if (window.__bellLast && now - window.__bellLast < 800) return; // throttle bursts
    window.__bellLast = now;
    var Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return;
    var ctx = window.__bellCtx || (window.__bellCtx = new Ctx());
    if (ctx.state === 'suspended') ctx.resume();
    var t = ctx.currentTime;
    [[880, 0.22], [1320, 0.11], [1760, 0.05]].forEach(function (p) { // fundamental + overtones
      var osc = ctx.createOscillator(), g = ctx.createGain();
      osc.type = 'sine'; osc.frequency.value = p[0];
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(p[1], t + 0.005);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 1.1);
      osc.connect(g); g.connect(ctx.destination);
      osc.start(t); osc.stop(t + 1.2);
    });
  } catch (e) {}
};
</script>

<header class="topbar">
  <a class="brand" href="/"><%= siteName %></a>
  <button class="menu-toggle" type="button" aria-label="Menu" onclick="document.body.classList.toggle('nav-open')">☰</button>
  <nav class="nav">
    <a href="/">Room</a>
    <% if (user) { %>
      <a href="/dm">Messages <span id="dm-badge" class="nav-badge"></span></a>
      <a href="/account">Account</a>
      <% if (isAdmin) { %><a href="/admin">🛡 Admin</a><% } %>
      <form action="/logout" method="post" class="inline"><button class="linkbtn" type="submit">Log out</button></form>
    <% } else { %>
      <a href="/dm">My chats <span id="dm-badge" class="nav-badge"></span></a>
      <a href="/login">Log in</a>
      <a href="/signup" class="btn small nav-cta">Get tipped</a>
    <% } %>
  </nav>
</header>

<main class="wrap<%= locals.wide ? ' wrap-wide' : '' %>">
  <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
  <%- body %>
</main>

<footer class="foot">
  <span><%= siteName %> · Adults only (18+) · Be safe and follow your local laws.</span>
</footer>

<div id="toasts" class="toasts"></div>

<div id="lightbox" class="lightbox" hidden>
  <button type="button" class="lb-close" aria-label="Close">✕</button>
  <img class="lb-img" alt="">
</div>

<script src="/public/emoji.js" defer></script>
<script src="/public/notify.js" defer></script>
<script>
// Tap-to-copy (crypto tip addresses, etc.)
document.addEventListener('click', function (e) {
  var b = e.target.closest('[data-copy]');
  if (!b) return;
  var val = b.getAttribute('data-copy');
  try { navigator.clipboard.writeText(val); } catch (err) {}
  var h = b.querySelector('.tip-handle');
  if (h) { var prev = h.textContent; h.textContent = 'Copied!'; setTimeout(function () { h.textContent = prev; }, 1200); }
});

// Lightbox: click a chat picture to enlarge it; X / outside / Esc closes.
(function () {
  var lb = document.getElementById('lightbox');
  if (!lb) return;
  var lbImg = lb.querySelector('.lb-img');
  function openLb(src) { lbImg.src = src; lb.hidden = false; document.body.style.overflow = 'hidden'; }
  function closeLb() { lb.hidden = true; lbImg.removeAttribute('src'); document.body.style.overflow = ''; }
  document.addEventListener('click', function (e) {
    var link = e.target.closest('.chat-img-link');
    if (link) { e.preventDefault(); openLb(link.getAttribute('href')); return; }
    if (e.target.closest('.lb-close') || e.target === lb) closeLb();
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !lb.hidden) closeLb(); });
})();

// Avatar fallback: a background-image can't error on its own, so if an avatar's
// photo fails to load we swap the blank circle for the person's initial.
(function () {
  function initialOf(el) {
    var n = (el.getAttribute('data-initial') || el.getAttribute('title') || '').trim();
    return n ? n.charAt(0).toUpperCase() : '';
  }
  function harden(el) {
    var m = (el.style.backgroundImage || '').match(/url\(["']?(.*?)["']?\)/);
    if (!m || !m[1]) return;
    var probe = new Image();
    probe.onerror = function () {
      el.style.backgroundImage = 'none';
      el.classList.add('avatar-broken');
      var ini = initialOf(el);
      el.textContent = ini || '👤';
      if (!ini) el.classList.add('avatar-glyph');
      // Photo's gone — nudge the owner to add one.
      document.querySelectorAll('.avatar-nudge[hidden]').forEach(function (n) { n.hidden = false; });
    };
    probe.src = m[1];
  }
  document.querySelectorAll('.avatar-preview, .rmsg-avatar, .chip-avatar, .who-avatar').forEach(harden);
  window.__hardenAvatar = harden; // dynamically-added avatars can opt in
})();
</script>
