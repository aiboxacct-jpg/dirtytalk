<%
  var _tips = (typeof tips !== 'undefined' && tips) ? tips : [];
  var _name = (typeof tipName !== 'undefined' && tipName) ? tipName : 'them';
%>
<% if (_tips.length) { %>
  <div class="tip-bar">
    <span class="tip-lead">💸 Tip <%= _name %></span>
    <% _tips.forEach(function(t){ %>
      <% if (t.kind === 'crypto') { %>
        <button type="button" class="tip-btn crypto" data-copy="<%= t.copy %>" title="Tap to copy: <%= t.copy %>">
          <%= t.label %> <span class="tip-handle"><%= t.display %></span>
        </button>
      <% } else if (t.href) { %>
        <a class="tip-btn <%= t.kind %>" href="<%= t.href %>" target="_blank" rel="noopener noreferrer">
          <%= t.label %> <span class="tip-handle"><%= t.display %></span>
        </a>
      <% } else { %>
        <span class="tip-btn <%= t.kind %> static" title="<%= t.display %>">
          <%= t.label %> <span class="tip-handle"><%= t.display %></span>
        </span>
      <% } %>
    <% }); %>
  </div>
<% } %>
