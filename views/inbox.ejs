<h1>Messages</h1>

<% if (threads.length === 0) { %>
  <div class="card"><p class="muted">No private chats yet. Head to <a href="/">the room</a> and tap
    <strong>Click Here To Chat Privately</strong> on someone to start one.</p></div>
<% } else { %>
  <div class="card list">
    <% threads.forEach(function(t){ %>
      <a class="list-row" href="<%= t.link %>">
        <span class="list-name"><%= t.other %><% if (t.admin_dm) { %> <span class="tag admin-dm">admin DM</span><% } else if (t.iamCreator) { %> <span class="tag">private</span><% } %></span>
        <span class="list-sub"><%= (t.last_body || '').slice(0, 60) %></span>
      </a>
    <% }); %>
  </div>
<% } %>

<script>
// Visiting the Messages inbox counts as reviewing them — mark every chat read
// and clear the unread badge (it re-appears when a genuinely new message lands).
(function () {
  fetch('/dm/activity', { headers: { accept: 'application/json' } })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (!d || !d.threads) return;
      var s; try { s = JSON.parse(localStorage.getItem('dt_dm_seen') || '{}'); } catch (e) { s = {}; }
      d.threads.forEach(function (t) { if (t.latestId > (s[t.id] || 0)) s[t.id] = t.latestId; });
      try { localStorage.setItem('dt_dm_seen', JSON.stringify(s)); } catch (e) {}
      var b = document.getElementById('dm-badge');
      if (b) { b.textContent = ''; b.classList.remove('show'); }
    })
    .catch(function () {});
})();
</script>
