<h1>Messages</h1>

<% if (threads.length === 0) { %>
  <div class="card"><p class="muted">No private chats yet. Head to <a href="/">the room</a> and tap
    <strong>Click Here To Chat Privately</strong> on someone to start one.</p></div>
<% } else { %>
  <div class="card list">
    <% threads.forEach(function(t){ %>
      <a class="list-row" href="<%= t.link %>">
        <span class="list-name"><%= t.other %><% if (t.iamCreator) { %> <span class="tag">private</span><% } %></span>
        <span class="list-sub"><%= (t.last_body || '').slice(0, 60) %></span>
      </a>
    <% }); %>
  </div>
<% } %>
