<p class="back"><a href="/dm">← All messages</a></p>

<div class="card">
  <div class="dm-head">
    <% if (otherAvatar) { %>
      <span class="avatar-preview" data-initial="<%= (otherName || '').charAt(0) %>" style="background-image:url('<%= otherAvatar %>')"></span>
    <% } %>
    <div class="dm-head-info">
      <div class="dm-title-row">
        <h1 class="dm-title"><%= otherName %><% if (otherGender) { %> <span class="gender <%= otherGender %>" title="<%= otherGender %>"><%= otherGender === 'male' ? '♂' : '♀' %></span><% } %><% if (otherVerified) { %> <span class="verified" title="Verified">✔</span><% } %></h1>
        <button type="button" id="dim-toggle" class="dim-toggle">🔅 Dim the lights…</button>
      </div>
      <p class="sub" style="margin-top:0;">
        <% if (isCreator) { %>Private chat<% } else { %>Private chat · <a href="/u/<%= otherHandle %>">view profile</a><% } %>
      </p>
      <% if (otherBio) { %><p class="dm-bio"><%= otherBio %></p><% } %>
    </div>
  </div>

  <% if (!isCreator && offer) { %>
    <div class="offer-card">🎁 <strong><%= otherName %>’s deal:</strong> <%= offer.price %> for <%= offer.minutes %> minutes of private chat — tip <%= offer.price %> below and your time unlocks.</div>
  <% } %>

  <% if (!isCreator && tips && tips.length) { %>
    <%- include('partials/tips', { tips: tips, tipName: thread.creator_name }) %>
  <% } %>

  <div id="dm-msgs" class="thread live">
    <% if (messages.length === 0) { %>
      <p class="muted" id="dm-empty">No messages yet — say hello 👋</p>
    <% } %>
    <% messages.forEach(function(m){ %>
      <div class="rmsg <%= m.mine ? 'mine' : '' %>" data-id="<%= m.id %>">
        <% if (m.replyTo) { %><div class="rmsg-quote">↩ <%= m.replyName %>: <%= m.replySnippet %></div><% } %>
        <div class="rmsg-head">
          <% if (m.avatar) { %>
            <% if (m.handle && !m.mine) { %><a class="rmsg-avatar" href="/u/<%= m.handle %>" style="background-image:url('<%= m.avatar %>')" title="<%= m.name %>"></a><% } else { %><span class="rmsg-avatar" style="background-image:url('<%= m.avatar %>')"></span><% } %>
          <% } %>
          <% if (m.fromCreator && !m.mine && m.handle) { %>
            <a class="rmsg-name creator" href="/u/<%= m.handle %>"><%= m.name %></a>
          <% } else { %>
            <span class="rmsg-name"><%= m.name %></span>
          <% } %>
          <% if (m.gender) { %><span class="gender <%= m.gender %>" title="<%= m.gender %>"><%= m.gender === 'male' ? '♂' : '♀' %></span><% } %>
          <% if (m.verified) { %><span class="verified" title="Verified">✔</span><% } %>
          <span class="rmsg-time"><%= (m.created_at || '').slice(11, 16) %></span>
          <% if (m.mine) { %><button type="button" class="rmsg-del" data-id="<%= m.id %>" title="Delete">✕</button><% } %>
        </div>
        <% if (m.image) { %><a class="chat-img-link" href="<%= m.image %>" target="_blank" rel="noopener"><img class="chat-img" src="<%= m.image %>" alt="shared picture" loading="lazy"></a><% } %>
        <% if (m.body) { %><div class="rmsg-body"><%= m.body %><button type="button" class="rmsg-reply" data-id="<%= m.id %>" data-name="<%= m.name %>">↩ Reply</button></div><% } else { %><button type="button" class="rmsg-reply solo" data-id="<%= m.id %>" data-name="<%= m.name %>">↩ Reply</button><% } %>
      </div>
    <% }); %>
  </div>

  <% if (!isCreator) { %>
    <div id="freebar" class="freebar" hidden>⏳ Free time left: <strong id="freetime">--:--</strong></div>
    <div id="paywall" class="paywall" hidden>
      <div class="paywall-title">🔒 Free time’s up</div>
      <p class="paywall-msg">Tip <%= otherName %> to keep the conversation going 💕</p>
      <%- include('partials/tips', { tips: tips, tipName: otherName }) %>
      <p class="paywall-wait muted">Once you’ve tipped, <%= otherName %> adds more time.</p>
    </div>
  <% } %>
  <% if (isCreator) { %>
    <div id="hostbar" class="hostbar">
      <label class="free-toggle" title="When checked, this chat is free. Uncheck to charge a tip to continue."><input type="checkbox" id="pw-free"> Free chat</label>
      <button type="button" id="pw-lock" class="btn small muted" hidden>💸 Turn on Pay Mode</button>
      <span id="pw-add-wrap" class="add-wrap" hidden>
        <input type="number" id="pw-add-min" class="add-min" min="1" max="240" step="1" value="<%= Math.round(paywall.freeSeconds / 60) %>" aria-label="Minutes to add">
        <button type="button" id="pw-add" class="btn small">➕ Add min</button>
      </span>
      <% if (offer) { %><button type="button" id="offer-grant" class="btn small offer-btn" data-min="<%= offer.minutes %>" data-price="<%= (offer.cents / 100).toFixed(2) %>" title="Guest paid your <%= offer.price %> offer — give them <%= offer.minutes %> minutes">🎁 Grant <%= offer.minutes %>m</button><% } %>
      <span id="hoststatus" class="host-status"></span>
      <button type="button" id="pay-received" class="btn small pay-btn" title="Tap when a tip lands — adds the site fee to your bill">💵 Payment received</button>
      <span id="pay-note" class="pay-note" hidden></span>
    </div>
    <p class="pay-warn">⚠ Only click “Payment received” if you have actually received the payment!</p>
  <% } %>

  <% if (!isCreator && !thread.admin_dm) { %>
    <div class="paid-notify-wrap">
      <button type="button" id="paid-notify" class="btn small paid-notify-btn">✅ I sent the payment</button>
      <span id="paid-notify-note" class="pay-note" hidden></span>
    </div>
    <% if (tips && tips.length) { %>
      <div id="paid-methods" class="paid-methods" hidden>
        <span class="paid-methods-label">Which one did you send it through?</span>
        <% tips.forEach(function(t){ %><button type="button" class="btn small paid-method" data-method="<%= t.label %>"><%= t.label %></button><% }); %>
        <button type="button" class="btn small muted paid-method" data-method="">Other / not sure</button>
      </div>
    <% } %>
  <% } %>

  <div id="typing-ind" class="typing-ind" hidden><%= otherName %> is typing<span class="typing-dots"><span>.</span><span>.</span><span>.</span></span></div>

  <div id="dm-reply-ctx" class="reply-ctx" hidden>
    ↩ Replying to <strong id="dm-reply-ctx-name"></strong>
    <button type="button" id="dm-reply-cancel" title="Cancel reply">✕</button>
  </div>

  <div id="dm-mention-list" class="mention-list" hidden></div>

  <form id="dm-form" class="chat-form" action="/dm/<%= thread.id %>/reply<%= tokenSuffix %>" method="post">
    <textarea id="dm-reply" name="body" rows="2" maxlength="2000" placeholder="Write a reply…" required></textarea>
    <button type="button" class="emoji-btn" data-target="dm-reply" aria-label="Emoji" title="Emoji">😊</button>
    <button type="button" class="photo-btn" id="dm-photo" aria-label="Send a picture" title="Send a picture">📷</button>
    <input type="file" id="dm-file" accept="image/*" hidden>
    <button class="btn" type="submit">Send</button>
  </form>

  <% if (!user) { %>
    <p class="hint">💡 Bookmark this page to come back to the chat and see replies.</p>
  <% } %>
</div>

<script>
(function () {
  var box = document.getElementById('dm-msgs');
  var form = document.getElementById('dm-form');
  var input = document.getElementById('dm-reply');
  var empty = document.getElementById('dm-empty');
  var otherName = <%- JSON.stringify(otherName) %>;
  var otherAvatar = <%- JSON.stringify(otherAvatar || null) %>;
  var typingInd = document.getElementById('typing-ind');
  var base = '/dm/<%= thread.id %>';
  var tokenQ = '<%= tokenSuffix %>';           // '?t=...' or ''
  var replyUrl = base + '/reply' + tokenQ;
  var uploadUrl = base + '/upload' + tokenQ;
  var typingUrl = base + '/typing' + tokenQ;

  // Tell the other person we're typing (throttled to once every ~2.5s).
  var lastTypingPing = 0;
  input.addEventListener('input', function () {
    var now = Date.now();
    if (now - lastTypingPing < 2500) return;
    lastTypingPing = now;
    fetch(typingUrl, { method: 'POST', headers: { accept: 'application/json' } }).catch(function () {});
  });
  function feedUrl(after) { return base + '/feed' + (tokenQ ? tokenQ + '&' : '?') + 'after=' + after; }
  var lastId = <%= messages.length ? messages[messages.length - 1].id : 0 %>;
  var atBottom = true;

  // Viewing this chat marks it read (clears its unread badge sitewide).
  function markSeen() {
    try {
      var s = JSON.parse(localStorage.getItem('dt_dm_seen') || '{}');
      s['<%= thread.id %>'] = lastId;
      localStorage.setItem('dt_dm_seen', JSON.stringify(s));
    } catch (e) {}
  }
  markSeen();

  // --- Paywall (tip to continue) — host toggles it live ----------------------
  var paywall = <%- JSON.stringify(paywall) %>;
  var isCreator = <%= isCreator ? 'true' : 'false' %>;
  var clockOffset = (paywall && paywall.now) ? (paywall.now - Date.now()) : 0; // server - client
  var freebar = document.getElementById('freebar');
  var freetimeEl = document.getElementById('freetime');
  var paywallPanel = document.getElementById('paywall');
  var hoststatus = document.getElementById('hoststatus');
  var pwFree = document.getElementById('pw-free');
  var pwLock = document.getElementById('pw-lock');
  var pwAdd = document.getElementById('pw-add');
  var pwAddWrap = document.getElementById('pw-add-wrap');
  var pwAddMin = document.getElementById('pw-add-min');

  function fmt(s) { s = Math.max(0, Math.round(s)); var m = Math.floor(s / 60), x = s % 60; return m + ':' + (x < 10 ? '0' : '') + x; }
  function composerEnabled(on) {
    input.disabled = !on;
    var btns = form.querySelectorAll('button, .emoji-btn, .photo-btn');
    for (var i = 0; i < btns.length; i++) btns[i].disabled = !on;
  }
  function show(el, on) { if (el) el.hidden = !on; }
  function renderPaywall() {
    var on = !!(paywall && paywall.on);
    var hasClock = on && !!paywall.freeUntil;
    var remaining = hasClock ? (paywall.freeUntil - (Date.now() + clockOffset)) / 1000 : null;
    var locked = hasClock && remaining <= 0;
    if (isCreator) {
      if (pwFree) pwFree.checked = !on;
      if (hoststatus) {
        hoststatus.textContent = !on ? ''
          : !hasClock ? 'Paid time on'
          : remaining > 0 ? '⏳ Guest’s free time: ' + fmt(remaining)
          : '⏸ Guest paused — waiting for a tip';
      }
      show(pwLock, on && hasClock && !locked);
      show(pwAddWrap, on && locked);
      return;
    }
    // Guest
    if (!on) { show(freebar, false); show(paywallPanel, false); composerEnabled(true); return; }
    show(freebar, hasClock && !locked);
    if (freetimeEl && !locked && remaining != null) freetimeEl.textContent = fmt(remaining);
    show(paywallPanel, locked);
    composerEnabled(!locked);
  }
  renderPaywall();
  setInterval(renderPaywall, 1000);

  async function hostAction(action, minutes) {
    try {
      var params = { action: action };
      if (minutes != null) params.minutes = String(minutes);
      var r = await fetch(base + '/host' + tokenQ, {
        method: 'POST',
        headers: { accept: 'application/json', 'content-type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(params),
      });
      var d = await r.json();
      if (d.ok && d.paywall) { paywall = d.paywall; clockOffset = paywall.now ? paywall.now - Date.now() : clockOffset; renderPaywall(); }
    } catch (e) {}
  }
  // Checked = free (paywall off); unchecked = start paid time.
  if (pwFree) pwFree.addEventListener('change', function () {
    paywall.on = !pwFree.checked; // optimistic, so the 1s refresh doesn't fight the click
    hostAction(pwFree.checked ? 'stop' : 'start');
  });
  if (pwLock) pwLock.addEventListener('click', function () { hostAction('lock'); });
  if (pwAdd) pwAdd.addEventListener('click', function () {
    var m = parseInt(pwAddMin && pwAddMin.value, 10);
    if (!Number.isFinite(m) || m < 1) m = 2;
    hostAction('add', m);
  });
  var payNote = document.getElementById('pay-note');
  var FEE_PCT = <%- JSON.stringify(feePct || 0) %>;
  // Record a received payment: bill = feePct% of the amount received. Shared by
  // the "Payment received" button and the offer grant.
  async function logPayment(amount) {
    try {
      var params = new URLSearchParams();
      if (amount != null) params.set('amount', String(amount));
      var r = await fetch(base + '/payment' + tokenQ, {
        method: 'POST',
        headers: { accept: 'application/json', 'content-type': 'application/x-www-form-urlencoded' },
        body: params,
      });
      var d = await r.json();
      if (d.ok && payNote) { payNote.textContent = '✓ Payment logged'; payNote.hidden = false; }
    } catch (e) {}
  }
  function askAmount(preset) {
    var raw = prompt('How much did you receive? (in $)\nThe ' + FEE_PCT + '% site fee is added to your bill.', preset || '');
    if (raw === null) return null; // cancelled
    var amt = parseFloat(String(raw).replace(/[^0-9.]/g, ''));
    if (!(amt > 0)) { alert('Please enter an amount greater than 0.'); return null; }
    return amt;
  }

  // One-time offer: grant the preset minutes once the guest has paid (counts as
  // a received payment — bills the fee on the offer price).
  var offerGrant = document.getElementById('offer-grant');
  if (offerGrant) offerGrant.addEventListener('click', function () {
    var m = parseInt(offerGrant.getAttribute('data-min'), 10);
    if (!(m > 0)) return;
    var price = parseFloat(offerGrant.getAttribute('data-price')) || 0;
    var amt = askAmount(price ? price.toFixed(2) : '');
    if (amt == null) return;
    hostAction('add', m);
    logPayment(amt);
  });

  // Creator confirms a received tip → adds the site fee to their bill.
  var payBtn = document.getElementById('pay-received');
  if (payBtn) payBtn.addEventListener('click', async function () {
    var amt = askAmount();
    if (amt == null) return;
    payBtn.disabled = true;
    await logPayment(amt);
    payBtn.disabled = false;
  });

  box.addEventListener('scroll', function () {
    atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 40;
  });
  // Delete your own message (the ✕ only shows on your messages).
  box.addEventListener('click', async function (e) {
    var btn = e.target.closest('.rmsg-del');
    if (!btn) return;
    if (!confirm('Delete this message?')) return;
    var id = btn.getAttribute('data-id');
    try {
      var r = await fetch(base + '/message/' + id + '/delete' + tokenQ, { method: 'POST', headers: { accept: 'application/json' } });
      if (r.ok) { var node = box.querySelector('.rmsg[data-id="' + id + '"]'); if (node) node.remove(); }
    } catch (e) {}
  });
  function scrollIfNeeded() { if (atBottom) box.scrollTop = box.scrollHeight; }
  scrollIfNeeded();

  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text; // textContent => XSS-safe
    return e;
  }
  // Turn URLs in a message into clickable links (XSS-safe: builds nodes).
  function linkifyInto(container, text) {
    text = String(text == null ? '' : text);
    var re = /((?:https?:\/\/|www\.)[^\s]+)/gi, last = 0, m;
    while ((m = re.exec(text))) {
      if (m.index > last) container.appendChild(document.createTextNode(text.slice(last, m.index)));
      var raw = m[0], trail = '', mt = raw.match(/[.,!?;:'")\]]+$/);
      if (mt) { trail = mt[0]; raw = raw.slice(0, raw.length - trail.length); }
      var a = document.createElement('a');
      a.href = /^https?:\/\//i.test(raw) ? raw : 'https://' + raw;
      a.target = '_blank'; a.rel = 'noopener noreferrer nofollow'; a.className = 'chat-link';
      a.textContent = raw;
      container.appendChild(a);
      if (trail) container.appendChild(document.createTextNode(trail));
      last = m.index + m[0].length;
    }
    if (last < text.length) container.appendChild(document.createTextNode(text.slice(last)));
  }
  // Render a message body: @mentions highlighted, URLs linkified.
  var MENTION_RE = /@([A-Za-z0-9][\w.\-]*)/g;
  function appendRich(container, text) {
    text = String(text == null ? '' : text);
    var last = 0, m;
    MENTION_RE.lastIndex = 0;
    while ((m = MENTION_RE.exec(text))) {
      if (m.index > last) linkifyInto(container, text.slice(last, m.index));
      container.appendChild(el('span', 'mention', m[0]));
      last = m.index + m[0].length;
    }
    if (last < text.length) linkifyInto(container, text.slice(last));
  }
  // Highlight @mentions + linkify the server-rendered messages already on screen.
  [].forEach.call(document.querySelectorAll('#dm-msgs .rmsg-body'), function (b) {
    var tn = b.firstChild;
    if (tn && tn.nodeType === 3 && /@|https?:\/\/|www\./i.test(tn.textContent)) {
      var frag = document.createDocumentFragment();
      appendRich(frag, tn.textContent);
      b.replaceChild(frag, tn);
    }
  });

  // --- @mentions in this private chat ---------------------------------------
  var myName = <%- JSON.stringify(myName || '') %>;
  function mentionsMe(body) {
    if (!myName || !body) return false;
    return new RegExp('@' + myName.replace(/[.*+?^${}()|[\]\\\-]/g, '\\$&') + '\\b', 'i').test(body);
  }
  function notifyMention() {
    if (window.playBell) window.playBell();
    var t = el('div', 'reply-toast', '💬 ' + otherName + ' mentioned you');
    t.addEventListener('click', function () { t.remove(); });
    document.body.appendChild(t);
    setTimeout(function () { t.classList.add('show'); }, 20);
    setTimeout(function () { t.classList.remove('show'); setTimeout(function () { t.remove(); }, 300); }, 5000);
  }
  // @ autocomplete — in a 1-on-1, suggest the other person.
  var dmMentionList = document.getElementById('dm-mention-list');
  function dmToken() {
    var pos = input.selectionStart == null ? input.value.length : input.selectionStart;
    var mm = input.value.slice(0, pos).match(/@([A-Za-z0-9][\w.\-]*)?$/);
    return mm ? { start: pos - mm[0].length, q: (mm[1] || '') } : null;
  }
  function dmHideMentions() { dmMentionList.hidden = true; dmMentionList.textContent = ''; }
  function dmInsert(tok, name) {
    var pos = input.selectionStart == null ? input.value.length : input.selectionStart;
    input.value = input.value.slice(0, tok.start) + '@' + name + ' ' + input.value.slice(pos);
    var caret = tok.start + name.length + 2;
    try { input.setSelectionRange(caret, caret); } catch (e) {}
    input.focus();
    dmHideMentions();
  }
  function dmShowMentions() {
    var tok = dmToken();
    if (!tok || !otherName) return dmHideMentions();
    if (otherName.toLowerCase().indexOf(tok.q.toLowerCase()) !== 0) return dmHideMentions();
    dmMentionList.textContent = '';
    var item = el('button', 'mention-item', '@' + otherName);
    item.type = 'button';
    item.addEventListener('mousedown', function (e) { e.preventDefault(); dmInsert(tok, otherName); });
    dmMentionList.appendChild(item);
    dmMentionList.hidden = false;
  }
  input.addEventListener('input', dmShowMentions);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') dmHideMentions();
    else if (e.key === 'Enter' && !e.shiftKey && !dmMentionList.hidden) {
      var first = dmMentionList.querySelector('.mention-item');
      if (first) { e.preventDefault(); first.dispatchEvent(new MouseEvent('mousedown')); }
    }
  });
  input.addEventListener('blur', function () { setTimeout(dmHideMentions, 150); });

  // --- Reply to a specific message -------------------------------------------
  var dmReplyTo = null;
  var dmReplyCtx = document.getElementById('dm-reply-ctx');
  var dmReplyCtxName = document.getElementById('dm-reply-ctx-name');
  function dmSetReply(id, name) {
    dmReplyTo = id;
    if (dmReplyCtxName) dmReplyCtxName.textContent = name || 'them';
    if (dmReplyCtx) dmReplyCtx.hidden = false;
    input.focus();
  }
  function dmClearReply() { dmReplyTo = null; if (dmReplyCtx) dmReplyCtx.hidden = true; }
  var dmReplyCancel = document.getElementById('dm-reply-cancel');
  if (dmReplyCancel) dmReplyCancel.addEventListener('click', dmClearReply);
  box.addEventListener('click', function (e) {
    var b = e.target.closest('.rmsg-reply');
    if (!b) return;
    dmSetReply(b.getAttribute('data-id'), b.getAttribute('data-name'));
  });
  function notifyReply(m) {
    if (window.playBell) window.playBell();
    var t = el('div', 'reply-toast', '↩ ' + (m.name === 'You' ? otherName : m.name) + ' replied to you');
    t.addEventListener('click', function () {
      var tg = box.querySelector('.rmsg[data-id="' + m.id + '"]');
      if (tg) tg.scrollIntoView({ behavior: 'smooth', block: 'center' });
      t.remove();
    });
    document.body.appendChild(t);
    setTimeout(function () { t.classList.add('show'); }, 20);
    setTimeout(function () { t.classList.remove('show'); setTimeout(function () { t.remove(); }, 300); }, 5000);
  }

  function addMessage(m) {
    if (empty) { empty.remove(); empty = null; }
    if (box.querySelector('.rmsg[data-id="' + m.id + '"]')) return;
    var wrap = el('div', 'rmsg' + (m.mine ? ' mine' : ''));
    wrap.setAttribute('data-id', m.id);
    if (m.replyTo) wrap.appendChild(el('div', 'rmsg-quote', '↩ ' + (m.replyName || '') + ': ' + (m.replySnippet || '')));
    var head = el('div', 'rmsg-head');
    if (m.avatar) {
      var av;
      if (m.handle && !m.mine) { av = el('a', 'rmsg-avatar'); av.href = '/u/' + m.handle; av.title = m.name; }
      else { av = el('span', 'rmsg-avatar'); }
      av.style.backgroundImage = "url('" + m.avatar + "')";
      head.appendChild(av);
    }
    if (m.fromCreator && !m.mine && m.handle) {
      var a = el('a', 'rmsg-name creator', m.name); a.href = '/u/' + m.handle; head.appendChild(a);
    } else {
      head.appendChild(el('span', 'rmsg-name', m.name));
    }
    if (m.gender) { var g = el('span', 'gender ' + m.gender, m.gender === 'male' ? '♂' : '♀'); g.title = m.gender; head.appendChild(g); }
    if (m.verified) { var v = el('span', 'verified', '✔'); v.title = 'Verified'; head.appendChild(v); }
    head.appendChild(el('span', 'rmsg-time', (m.created_at || '').slice(11, 16)));
    if (m.mine) {
      var del = el('button', 'rmsg-del', '✕');
      del.type = 'button'; del.setAttribute('data-id', m.id); del.title = 'Delete';
      head.appendChild(del);
    }
    wrap.appendChild(head);
    if (m.image) {
      var link = document.createElement('a');
      link.className = 'chat-img-link'; link.href = m.image; link.target = '_blank'; link.rel = 'noopener';
      var img = document.createElement('img');
      img.className = 'chat-img'; img.src = m.image; img.alt = 'shared picture'; img.loading = 'lazy';
      img.addEventListener('load', scrollIfNeeded);
      link.appendChild(img);
      wrap.appendChild(link);
    }
    var rbtn = el('button', 'rmsg-reply', '↩ Reply');
    rbtn.type = 'button'; rbtn.setAttribute('data-id', m.id); rbtn.setAttribute('data-name', m.name);
    if (m.body) {
      var bodyEl = el('div', 'rmsg-body'); appendRich(bodyEl, m.body);
      bodyEl.appendChild(rbtn); // reply lives inside the bubble
      wrap.appendChild(bodyEl);
    } else {
      rbtn.className = 'rmsg-reply solo';
      wrap.appendChild(rbtn);
    }
    box.appendChild(wrap);
    if (m.id > lastId) lastId = m.id;
  }

  async function poll() {
    try {
      var r = await fetch(feedUrl(lastId), { headers: { accept: 'application/json' } });
      if (!r.ok) return;
      var data = await r.json();
      if (data.paywall) { paywall = data.paywall; clockOffset = paywall.now ? paywall.now - Date.now() : clockOffset; renderPaywall(); }
      if (typingInd) { var wasHidden = typingInd.hidden; typingInd.hidden = !data.typing; if (wasHidden && data.typing) scrollIfNeeded(); }
      if (data.messages && data.messages.length) {
        data.messages.forEach(function (m) {
          addMessage(m);
          if (!m.mine && window.playBell) window.playBell(); // bell on a new private message
          if (m.replyToMe && !m.mine) notifyReply(m); // the other person replied to your message
          else if (!m.mine && mentionsMe(m.body)) notifyMention(); // or @mentioned you
        });
        scrollIfNeeded(); markSeen();
      }
    } catch (e) {}
  }
  setInterval(poll, 4000);

  // Buyer tells the host they've sent payment (works even while paused). If the
  // host has 2+ payment links, the buyer first picks which one they used.
  var paidBtn = document.getElementById('paid-notify');
  var paidNote = document.getElementById('paid-notify-note');
  var paidMethods = document.getElementById('paid-methods');
  var realMethods = paidMethods
    ? [].filter.call(paidMethods.querySelectorAll('.paid-method'), function (b) { return b.getAttribute('data-method'); })
    : [];
  async function sendPaid(method) {
    if (paidMethods) paidMethods.hidden = true;
    paidBtn.disabled = true;
    try {
      var params = new URLSearchParams();
      if (method) params.set('method', method);
      var r = await fetch(base + '/paid-notify' + tokenQ, {
        method: 'POST',
        headers: { accept: 'application/json', 'content-type': 'application/x-www-form-urlencoded' },
        body: params,
      });
      var d = await r.json();
      if (d.ok) {
        if (paidNote) { paidNote.textContent = '✓ Host notified'; paidNote.hidden = false; }
        atBottom = true; await poll();
      }
    } catch (e) {}
    setTimeout(function () { paidBtn.disabled = false; }, 30000);
  }
  if (paidBtn) paidBtn.addEventListener('click', function () {
    if (realMethods.length >= 2) { // let them choose which link they used
      if (paidMethods) paidMethods.hidden = !paidMethods.hidden;
      return;
    }
    if (!confirm('Let the host know you sent your payment?')) return;
    sendPaid(realMethods.length === 1 ? realMethods[0].getAttribute('data-method') : '');
  });
  if (paidMethods) paidMethods.addEventListener('click', function (e) {
    var b = e.target.closest('.paid-method');
    if (b) sendPaid(b.getAttribute('data-method'));
  });

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    var body = input.value.trim();
    if (!body) return;
    var params = { body: body };
    if (dmReplyTo) params.reply_to = dmReplyTo;
    try {
      var r = await fetch(replyUrl, {
        method: 'POST',
        headers: { accept: 'application/json', 'content-type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(params),
      });
      if (r.ok) { input.value = ''; dmClearReply(); atBottom = true; await poll(); } // poll pulls in our message (and any we missed)
      else if (r.status === 402) { await poll(); } // free time's up — show the paywall
    } catch (e) {}
  });

  // Picture upload
  var photoBtn = document.getElementById('dm-photo');
  var fileInput = document.getElementById('dm-file');
  photoBtn.addEventListener('click', function () { fileInput.click(); });
  fileInput.addEventListener('change', async function () {
    var file = fileInput.files[0];
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) { alert('That image is too large (max 10 MB). Please pick a smaller one.'); fileInput.value = ''; return; }
    var fd = new FormData();
    fd.append('image', file);
    if (dmReplyTo) fd.append('reply_to', dmReplyTo);
    dmClearReply();
    photoBtn.disabled = true;
    var orig = photoBtn.textContent; photoBtn.textContent = '⏳';
    try {
      var r = await fetch(uploadUrl, { method: 'POST', headers: { accept: 'application/json' }, body: fd });
      var text = await r.text();
      var data = null; try { data = JSON.parse(text); } catch (e) {}
      if (r.ok && data && data.ok) { atBottom = true; await poll(); }
      else if (data && data.locked) { await poll(); } // free time's up — show the paywall
      else if (data && data.error) alert(data.error);
      else alert('Upload didn’t go through — please refresh the page and try again.');
    } catch (e) { alert('Upload didn’t go through — please refresh the page and try again.'); }
    photoBtn.disabled = false; photoBtn.textContent = orig;
    fileInput.value = '';
  });
})();

// "Dim the lights" — dark mood for private chats, remembered per device.
(function () {
  var btn = document.getElementById('dim-toggle');
  if (!btn) return;
  function apply(on) {
    document.body.classList.toggle('dim', on);
    btn.textContent = on ? '☀️ Lights on' : '🔅 Dim the lights…';
  }
  var on = false;
  try { on = localStorage.getItem('dm_dim') === '1'; } catch (e) {}
  apply(on);
  btn.addEventListener('click', function () {
    on = !on;
    try { localStorage.setItem('dm_dim', on ? '1' : '0'); } catch (e) {}
    apply(on);
  });
})();
</script>
