<div class="room-head">
  <h1>The Room</h1>
  <p class="sub">Get naughty 😈 Flirt with the room, then hit <strong>Click Here To Chat Privately</strong> on someone's message to slip into a private DM. Enjoy your talk! (18+)</p>
</div>

<% if (isAdmin) { %>
  <div class="admin-bar">
    <span class="admin-tag">🛡 Admin</span>
    <button type="button" id="clear-room" class="btn small muted">🗑 Clear room</button>
  </div>
<% } %>

<div class="creators-strip" id="here-now"<% if (!creators.length && !guests) { %> hidden<% } %>>
  <span class="strip-label">Here now:</span>
  <% creators.forEach(function(c){ %>
    <a class="creator-chip" href="/u/<%= c.handle || c.id %>"><% if (c.avatar_url) { %><span class="chip-avatar" style="background-image:url('<%= c.avatar_url %>')"></span><% } %><%= c.name %><% if (c.gender) { %> <span class="gender <%= c.gender %>"><%= c.gender === 'male' ? '♂' : '♀' %></span><% } %><% if (c.verified) { %> <span class="verified" title="Verified">✔</span><% } %></a>
  <% }); %>
  <span class="guest-chip" id="guest-chip"<% if (!guests) { %> hidden<% } %>>👀 <span id="guest-count"><%= guests %></span> guest<span id="guest-plural"><%= guests === 1 ? '' : 's' %></span></span>
</div>

<div class="room-box">
  <div id="room-msgs" class="room-msgs">
    <% if (messages.length === 0) { %>
      <p class="muted" id="room-empty">No messages yet — be the first to say something 👋</p>
    <% } %>
    <% messages.forEach(function(m){ %>
      <div class="rmsg <%= m.mine ? 'mine' : '' %>" data-id="<%= m.id %>">
        <% if (m.replyTo) { %><div class="rmsg-quote">↩ <%= m.replyName %>: <%= m.replySnippet %></div><% } %>
        <div class="rmsg-head">
          <% if (m.avatar) { %><a class="rmsg-avatar" href="/u/<%= m.creatorHandle %>" style="background-image:url('<%= m.avatar %>')" title="<%= m.name %>"></a><% } %>
          <% if (m.creatorId && !m.mine) { %>
            <a class="rmsg-name creator" href="/u/<%= m.creatorHandle %>"><%= m.name %></a>
          <% } else { %>
            <span class="rmsg-name"><%= m.name %></span>
          <% } %>
          <% if (m.gender) { %><span class="gender <%= m.gender %>" title="<%= m.gender %>"><%= m.gender === 'male' ? '♂' : '♀' %></span><% } %>
          <% if (m.verified) { %><span class="verified" title="Verified">✔</span><% } %>
          <% if (m.creatorId && !m.mine) { %><a class="rmsg-dm" href="/u/<%= m.creatorHandle %>#tip">💬 Click Here To Chat Privately</a><% } %>
          <span class="rmsg-time"><%= (m.created_at || '').slice(11,16) %></span>
          <% if (isAdmin) { %><button type="button" class="rmsg-del" data-id="<%= m.id %>" title="Delete">✕</button><% } %>
        </div>
        <% if (m.image) { %>
          <a class="chat-img-link" href="<%= m.image %>" target="_blank" rel="noopener"><img class="chat-img" src="<%= m.image %>" alt="shared picture" loading="lazy"></a>
        <% } %>
        <% if (m.body) { %><div class="rmsg-body"><%= m.body %><button type="button" class="rmsg-reply" data-id="<%= m.id %>" data-name="<%= m.name %>">↩ Reply</button></div><% } else { %><button type="button" class="rmsg-reply solo" data-id="<%= m.id %>" data-name="<%= m.name %>">↩ Reply</button><% } %>
      </div>
    <% }); %>
  </div>

  <div id="room-typing" class="typing-ind" hidden></div>

  <div id="reply-ctx" class="reply-ctx" hidden>
    ↩ Replying to <strong id="reply-ctx-name"></strong>
    <button type="button" id="reply-cancel" title="Cancel reply">✕</button>
  </div>

  <div id="mention-list" class="mention-list" hidden></div>

  <form id="room-form" class="room-form" action="/room" method="post">
    <% if (isGuest) { %>
      <input type="text" id="room-name" name="name" maxlength="30" value="<%= suggestedName %>" placeholder="Your name">
    <% } %>
    <input type="text" id="room-body" name="body" maxlength="500" placeholder="Type a message…" autocomplete="off" required>
    <button type="button" class="emoji-btn" data-target="room-body" aria-label="Emoji" title="Emoji">😊</button>
    <button type="button" class="photo-btn" id="room-photo" aria-label="Send a picture" title="Send a picture">📷</button>
    <input type="file" id="room-file" accept="image/*" hidden>
    <button class="btn" type="submit">Send</button>
  </form>
</div>

<% if (isGuest) { %>
  <p class="hint">Chatting as a guest — no signup needed. Want to <strong>get tipped</strong> and go private?
    <a href="/signup">Create a creator account</a>.</p>
<% } %>

<script>
(function () {
  var box = document.getElementById('room-msgs');
  var form = document.getElementById('room-form');
  var input = document.getElementById('room-body');
  var nameInput = document.getElementById('room-name');
  var typingEl = document.getElementById('room-typing');
  var empty = document.getElementById('room-empty');

  // --- Reply system: tap "Reply" on a message to answer it (and notify them) --
  var replyTo = null;
  var replyCtx = document.getElementById('reply-ctx');
  var replyCtxName = document.getElementById('reply-ctx-name');
  function setReply(id, name) {
    replyTo = id;
    if (replyCtxName) replyCtxName.textContent = name || 'them';
    if (replyCtx) replyCtx.hidden = false;
    input.focus();
  }
  function clearReply() { replyTo = null; if (replyCtx) replyCtx.hidden = true; }
  var replyCancel = document.getElementById('reply-cancel');
  if (replyCancel) replyCancel.addEventListener('click', clearReply);

  // --- @mentions: type @name to ping someone; they get notified -------------
  var myBaseName = <%- JSON.stringify(suggestedName) %>;
  function getMyName() { return (nameInput ? nameInput.value.trim() : '') || myBaseName; }
  var MENTION_RE = /@([A-Za-z0-9][\w.\-]*)/g;
  // Append text to a container, wrapping @mentions in a highlight span (XSS-safe).
  function appendMentions(container, text) {
    text = String(text == null ? '' : text);
    var last = 0, m;
    MENTION_RE.lastIndex = 0;
    while ((m = MENTION_RE.exec(text))) {
      if (m.index > last) container.appendChild(document.createTextNode(text.slice(last, m.index)));
      container.appendChild(el('span', 'mention', m[0]));
      last = m.index + m[0].length;
    }
    if (last < text.length) container.appendChild(document.createTextNode(text.slice(last)));
  }
  function mentionsMe(body) {
    var name = getMyName();
    if (!name || !body) return false;
    return new RegExp('@' + name.replace(/[.*+?^${}()|[\]\\\-]/g, '\\$&') + '\\b', 'i').test(body);
  }
  function notifyMention(m) {
    var t = el('div', 'reply-toast', '💬 ' + (m.name || 'Someone') + ' mentioned you');
    t.addEventListener('click', function () {
      var tg = box.querySelector('.rmsg[data-id="' + m.id + '"]');
      if (tg) tg.scrollIntoView({ behavior: 'smooth', block: 'center' });
      t.remove();
    });
    document.body.appendChild(t);
    setTimeout(function () { t.classList.add('show'); }, 20);
    setTimeout(function () { t.classList.remove('show'); setTimeout(function () { t.remove(); }, 300); }, 5000);
  }
  // Highlight @mentions in the server-rendered messages already on screen.
  [].forEach.call(document.querySelectorAll('#room-msgs .rmsg-body'), function (b) {
    var tn = b.firstChild;
    if (tn && tn.nodeType === 3 && tn.textContent.indexOf('@') > -1) {
      var frag = document.createDocumentFragment();
      appendMentions(frag, tn.textContent);
      b.replaceChild(frag, tn);
    }
  });

  // @ autocomplete: suggest recent chatters / online creators.
  var mentionList = document.getElementById('mention-list');
  function candidateNames() {
    var seen = {}, out = [];
    function add(n) { n = (n || '').trim(); if (n && !seen[n.toLowerCase()]) { seen[n.toLowerCase()] = 1; out.push(n); } }
    [].forEach.call(document.querySelectorAll('#room-msgs .rmsg-name'), function (e) { add(e.textContent); });
    [].forEach.call(document.querySelectorAll('.creator-chip'), function (e) { add(e.textContent.replace(/[♂♀✔]/g, '')); });
    var me = getMyName().toLowerCase();
    return out.filter(function (n) { return n.toLowerCase() !== me; });
  }
  function currentToken() {
    var pos = input.selectionStart == null ? input.value.length : input.selectionStart;
    var m = input.value.slice(0, pos).match(/@([A-Za-z0-9][\w.\-]*)?$/);
    return m ? { start: pos - m[0].length, q: (m[1] || '') } : null;
  }
  function hideMentions() { mentionList.hidden = true; mentionList.textContent = ''; }
  function insertMention(tok, name) {
    var pos = input.selectionStart == null ? input.value.length : input.selectionStart;
    input.value = input.value.slice(0, tok.start) + '@' + name + ' ' + input.value.slice(pos);
    var caret = tok.start + name.length + 2;
    try { input.setSelectionRange(caret, caret); } catch (e) {}
    input.focus();
    hideMentions();
  }
  function showMentions() {
    var tok = currentToken();
    if (!tok) return hideMentions();
    var q = tok.q.toLowerCase();
    var matches = candidateNames().filter(function (n) { return n.toLowerCase().indexOf(q) === 0; }).slice(0, 6);
    if (!matches.length) return hideMentions();
    mentionList.textContent = '';
    matches.forEach(function (n) {
      var item = el('button', 'mention-item', '@' + n);
      item.type = 'button';
      item.addEventListener('mousedown', function (e) { e.preventDefault(); insertMention(tok, n); });
      mentionList.appendChild(item);
    });
    mentionList.hidden = false;
  }
  input.addEventListener('input', showMentions);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') hideMentions();
    else if (e.key === 'Enter' && !mentionList.hidden) {
      var first = mentionList.querySelector('.mention-item');
      if (first) { e.preventDefault(); first.dispatchEvent(new MouseEvent('mousedown')); }
    }
  });
  input.addEventListener('blur', function () { setTimeout(hideMentions, 150); });

  // Tell the room we're typing (throttled to once every ~2.5s).
  var lastTypingPing = 0;
  input.addEventListener('input', function () {
    var now = Date.now();
    if (now - lastTypingPing < 2500) return;
    lastTypingPing = now;
    var p = new URLSearchParams();
    if (nameInput) p.set('name', nameInput.value);
    fetch('/typing', {
      method: 'POST',
      headers: { accept: 'application/json', 'content-type': 'application/x-www-form-urlencoded' },
      body: p,
    }).catch(function () {});
  });

  function updateGuests(n) {
    var chip = document.getElementById('guest-chip');
    if (!chip) return;
    document.getElementById('guest-count').textContent = n;
    document.getElementById('guest-plural').textContent = n === 1 ? '' : 's';
    chip.hidden = !n;
    var strip = document.getElementById('here-now');
    if (strip && n) strip.hidden = false; // guests showed up — reveal the strip
  }

  function renderTyping(names) {
    if (!typingEl) return;
    names = names || [];
    if (!names.length) { typingEl.hidden = true; typingEl.textContent = ''; return; }
    var text = names.length === 1 ? names[0] + ' is typing'
      : names.length === 2 ? names[0] + ' and ' + names[1] + ' are typing'
      : 'Several people are typing';
    typingEl.textContent = ''; // textContent for names => XSS-safe
    typingEl.appendChild(document.createTextNode(text));
    var dots = el('span', 'typing-dots');
    dots.appendChild(el('span', null, '.'));
    dots.appendChild(el('span', null, '.'));
    dots.appendChild(el('span', null, '.'));
    typingEl.appendChild(dots);
    var wasHidden = typingEl.hidden;
    typingEl.hidden = false;
    if (wasHidden) scrollIfNeeded();
  }
  var isAdmin = <%= isAdmin ? 'true' : 'false' %>;
  var lastId = <%= messages.length ? messages[messages.length - 1].id : 0 %>;
  var atBottom = true;

  box.addEventListener('scroll', function () {
    atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 40;
  });
  // "Reply" buttons (server-rendered or live) start a reply to that message.
  box.addEventListener('click', function (e) {
    var b = e.target.closest('.rmsg-reply');
    if (!b) return;
    setReply(b.getAttribute('data-id'), b.getAttribute('data-name'));
  });
  function scrollIfNeeded() { if (atBottom) box.scrollTop = box.scrollHeight; }
  scrollIfNeeded();

  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text; // textContent => XSS-safe
    return e;
  }
  function addMessage(m) {
    if (empty) { empty.remove(); empty = null; }
    if (box.querySelector('.rmsg[data-id="' + m.id + '"]')) return;
    var wrap = el('div', 'rmsg' + (m.mine ? ' mine' : ''));
    wrap.setAttribute('data-id', m.id);
    if (m.replyTo) wrap.appendChild(el('div', 'rmsg-quote', '↩ ' + (m.replyName || '') + ': ' + (m.replySnippet || '')));
    var head = el('div', 'rmsg-head');
    if (m.avatar) {
      var av = el('a', 'rmsg-avatar');
      av.href = '/u/' + m.creatorHandle;
      av.style.backgroundImage = "url('" + m.avatar + "')";
      av.title = m.name;
      head.appendChild(av);
    }
    if (m.creatorId && !m.mine) {
      var a = el('a', 'rmsg-name creator', m.name);
      a.href = '/u/' + m.creatorHandle;
      head.appendChild(a);
    } else {
      head.appendChild(el('span', 'rmsg-name', m.name));
    }
    if (m.gender) { var g = el('span', 'gender ' + m.gender, m.gender === 'male' ? '♂' : '♀'); g.title = m.gender; head.appendChild(g); }
    if (m.verified) { var v = el('span', 'verified', '✔'); v.title = 'Verified'; head.appendChild(v); }
    if (m.creatorId && !m.mine) {
      var dm = el('a', 'rmsg-dm', '💬 Click Here To Chat Privately');
      dm.href = '/u/' + m.creatorHandle + '#tip';
      head.appendChild(dm); // next to the username
    }
    head.appendChild(el('span', 'rmsg-time', (m.created_at || '').slice(11, 16)));
    if (isAdmin) {
      var del = el('button', 'rmsg-del', '✕');
      del.type = 'button';
      del.setAttribute('data-id', m.id);
      del.title = 'Delete';
      head.appendChild(del);
    }
    wrap.appendChild(head);
    if (m.image) {
      var link = document.createElement('a');
      link.className = 'chat-img-link'; link.href = m.image; link.target = '_blank'; link.rel = 'noopener';
      var img = document.createElement('img');
      img.className = 'chat-img'; img.src = m.image; img.alt = 'shared picture'; img.loading = 'lazy';
      img.addEventListener('load', scrollIfNeeded);
      link.appendChild(img);
      wrap.appendChild(link);
    }
    var rbtn = el('button', 'rmsg-reply', '↩ Reply');
    rbtn.type = 'button'; rbtn.setAttribute('data-id', m.id); rbtn.setAttribute('data-name', m.name);
    if (m.body) {
      var bodyEl = el('div', 'rmsg-body');
      appendMentions(bodyEl, m.body); // highlight @mentions
      bodyEl.appendChild(rbtn); // reply lives inside the bubble
      wrap.appendChild(bodyEl);
    } else {
      rbtn.className = 'rmsg-reply solo';
      wrap.appendChild(rbtn);
    }
    box.appendChild(wrap);
    if (m.id > lastId) lastId = m.id;
  }

  function notifyReply(m) {
    var t = el('div', 'reply-toast', '↩ ' + (m.name || 'Someone') + ' replied to you');
    t.addEventListener('click', function () {
      var target = box.querySelector('.rmsg[data-id="' + m.id + '"]');
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      t.remove();
    });
    document.body.appendChild(t);
    setTimeout(function () { t.classList.add('show'); }, 20); // fade in (rAF-free: works when backgrounded)
    setTimeout(function () { t.classList.remove('show'); setTimeout(function () { t.remove(); }, 300); }, 5000);
  }

  async function poll() {
    try {
      var r = await fetch('/feed?after=' + lastId, { headers: { accept: 'application/json' } });
      var data = await r.json();
      if (data.messages && data.messages.length) {
        data.messages.forEach(function (m) {
          addMessage(m);
          if (m.replyToMe && !m.mine) notifyReply(m); // someone answered your message
          if (!m.mine && mentionsMe(m.body)) notifyMention(m); // someone @mentioned you
        });
        scrollIfNeeded();
      }
      renderTyping(data.typing);
      if (typeof data.guests === 'number') updateGuests(data.guests);
    } catch (e) {}
  }
  setInterval(poll, 4000);

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    var body = input.value.trim();
    if (!body) return;
    var params = new URLSearchParams();
    params.set('body', body);
    if (nameInput) params.set('name', nameInput.value);
    if (replyTo) params.set('reply_to', replyTo);
    input.value = '';
    clearReply();
    try {
      var r = await fetch('/room', {
        method: 'POST',
        headers: { accept: 'application/json', 'content-type': 'application/x-www-form-urlencoded' },
        body: params,
      });
      var data = await r.json();
      if (data.ok && data.message) { atBottom = true; addMessage(data.message); scrollIfNeeded(); }
    } catch (e) {}
  });

  // Picture upload
  var photoBtn = document.getElementById('room-photo');
  var fileInput = document.getElementById('room-file');
  photoBtn.addEventListener('click', function () { fileInput.click(); });
  fileInput.addEventListener('change', async function () {
    var file = fileInput.files[0];
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) { alert('That image is too large (max 10 MB). Please pick a smaller one.'); fileInput.value = ''; return; }
    var fd = new FormData();
    fd.append('image', file);
    if (nameInput) fd.append('name', nameInput.value);
    if (replyTo) fd.append('reply_to', replyTo);
    clearReply();
    photoBtn.disabled = true;
    var orig = photoBtn.textContent; photoBtn.textContent = '⏳';
    try {
      var r = await fetch('/room/upload', { method: 'POST', headers: { accept: 'application/json' }, body: fd });
      var text = await r.text();
      var data = null; try { data = JSON.parse(text); } catch (e) {}
      if (r.ok && data && data.ok && data.message) { atBottom = true; addMessage(data.message); scrollIfNeeded(); }
      else if (data && data.error) alert(data.error);
      else alert('Upload didn’t go through — please refresh the page and try again.');
    } catch (e) { alert('Upload didn’t go through — please refresh the page and try again.'); }
    photoBtn.disabled = false; photoBtn.textContent = orig;
    fileInput.value = '';
  });

  // Admin moderation: delete a message, or clear the whole room
  if (isAdmin) {
    box.addEventListener('click', async function (e) {
      var btn = e.target.closest('.rmsg-del');
      if (!btn) return;
      var id = btn.getAttribute('data-id');
      try {
        await fetch('/room/' + id + '/delete', { method: 'POST', headers: { accept: 'application/json' } });
        var node = box.querySelector('.rmsg[data-id="' + id + '"]');
        if (node) node.remove();
      } catch (e) {}
    });
    var clearBtn = document.getElementById('clear-room');
    if (clearBtn) clearBtn.addEventListener('click', async function () {
      if (!confirm('Clear the entire room? This deletes every message and picture for everyone.')) return;
      clearBtn.disabled = true;
      try {
        var r = await fetch('/room/clear', { method: 'POST', headers: { accept: 'application/json' } });
        if (r.ok) {
          var msgs = box.querySelectorAll('.rmsg');
          for (var i = 0; i < msgs.length; i++) msgs[i].remove();
          if (!document.getElementById('room-empty')) {
            var p = el('p', 'muted'); p.id = 'room-empty';
            p.textContent = 'No messages yet — be the first to say something 👋';
            box.appendChild(p); empty = p;
          }
        }
      } catch (e) {}
      clearBtn.disabled = false;
    });
  }
})();
</script>
