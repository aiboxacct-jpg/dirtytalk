<div class="room-head">
  <h1>The Room</h1>
  <p class="sub">Get naughty 😈 Flirt with the room, then hit <strong>Click Here To Chat Privately</strong> on someone's message to slip into a private DM. Enjoy your talk! (18+)</p>
</div>

<% if (isAdmin) { %>
  <div class="admin-bar">
    <span class="admin-tag">🛡 Admin</span>
    <button type="button" id="clear-room" class="btn small muted">🗑 Clear room</button>
  </div>
<% } %>

<% if (creators.length) { %>
  <div class="creators-strip">
    <span class="strip-label">Here now:</span>
    <% creators.forEach(function(c){ %>
      <a class="creator-chip" href="/u/<%= c.handle || c.id %>"><% if (c.avatar_url) { %><span class="chip-avatar" style="background-image:url('<%= c.avatar_url %>')"></span><% } %><%= c.name %><% if (c.verified) { %> <span class="verified" title="Verified">✔</span><% } %></a>
    <% }); %>
  </div>
<% } %>

<div class="room-box">
  <div id="room-msgs" class="room-msgs">
    <% if (messages.length === 0) { %>
      <p class="muted" id="room-empty">No messages yet — be the first to say something 👋</p>
    <% } %>
    <% messages.forEach(function(m){ %>
      <div class="rmsg <%= m.mine ? 'mine' : '' %>" data-id="<%= m.id %>">
        <div class="rmsg-head">
          <% if (m.avatar) { %><a class="rmsg-avatar" href="/u/<%= m.creatorHandle %>" style="background-image:url('<%= m.avatar %>')" title="<%= m.name %>"></a><% } %>
          <% if (m.creatorId && !m.mine) { %>
            <a class="rmsg-name creator" href="/u/<%= m.creatorHandle %>"><%= m.name %></a>
          <% } else { %>
            <span class="rmsg-name"><%= m.name %></span>
          <% } %>
          <% if (m.verified) { %><span class="verified" title="Verified">✔</span><% } %>
          <span class="rmsg-time"><%= (m.created_at || '').slice(11,16) %></span>
          <% if (m.creatorId && !m.mine) { %><a class="rmsg-dm" href="/u/<%= m.creatorHandle %>#tip">💬 Click Here To Chat Privately</a><% } %>
          <% if (isAdmin) { %><button type="button" class="rmsg-del" data-id="<%= m.id %>" title="Delete">✕</button><% } %>
        </div>
        <% if (m.image) { %>
          <a class="chat-img-link" href="<%= m.image %>" target="_blank" rel="noopener"><img class="chat-img" src="<%= m.image %>" alt="shared picture" loading="lazy"></a>
        <% } %>
        <% if (m.body) { %><div class="rmsg-body"><%= m.body %></div><% } %>
      </div>
    <% }); %>
  </div>

  <form id="room-form" class="room-form" action="/room" method="post">
    <% if (isGuest) { %>
      <input type="text" id="room-name" name="name" maxlength="30" value="<%= suggestedName %>" placeholder="Your name">
    <% } %>
    <input type="text" id="room-body" name="body" maxlength="500" placeholder="Type a message…" autocomplete="off" required>
    <button type="button" class="emoji-btn" data-target="room-body" aria-label="Emoji" title="Emoji">😊</button>
    <button type="button" class="photo-btn" id="room-photo" aria-label="Send a picture" title="Send a picture">📷</button>
    <input type="file" id="room-file" accept="image/*" hidden>
    <button class="btn" type="submit">Send</button>
  </form>
</div>

<% if (isGuest) { %>
  <p class="hint">Chatting as a guest — no signup needed. Want to <strong>get tipped</strong> and go private?
    <a href="/signup">Create a creator account</a>.</p>
<% } %>

<script>
(function () {
  var box = document.getElementById('room-msgs');
  var form = document.getElementById('room-form');
  var input = document.getElementById('room-body');
  var nameInput = document.getElementById('room-name');
  var empty = document.getElementById('room-empty');
  var isAdmin = <%= isAdmin ? 'true' : 'false' %>;
  var lastId = <%= messages.length ? messages[messages.length - 1].id : 0 %>;
  var atBottom = true;

  box.addEventListener('scroll', function () {
    atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 40;
  });
  function scrollIfNeeded() { if (atBottom) box.scrollTop = box.scrollHeight; }
  scrollIfNeeded();

  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text; // textContent => XSS-safe
    return e;
  }
  function addMessage(m) {
    if (empty) { empty.remove(); empty = null; }
    if (box.querySelector('.rmsg[data-id="' + m.id + '"]')) return;
    var wrap = el('div', 'rmsg' + (m.mine ? ' mine' : ''));
    wrap.setAttribute('data-id', m.id);
    var head = el('div', 'rmsg-head');
    if (m.avatar) {
      var av = el('a', 'rmsg-avatar');
      av.href = '/u/' + m.creatorHandle;
      av.style.backgroundImage = "url('" + m.avatar + "')";
      av.title = m.name;
      head.appendChild(av);
    }
    if (m.creatorId && !m.mine) {
      var a = el('a', 'rmsg-name creator', m.name);
      a.href = '/u/' + m.creatorHandle;
      head.appendChild(a);
    } else {
      head.appendChild(el('span', 'rmsg-name', m.name));
    }
    if (m.verified) { var v = el('span', 'verified', '✔'); v.title = 'Verified'; head.appendChild(v); }
    head.appendChild(el('span', 'rmsg-time', (m.created_at || '').slice(11, 16)));
    if (m.creatorId && !m.mine) {
      var dm = el('a', 'rmsg-dm', '💬 Click Here To Chat Privately');
      dm.href = '/u/' + m.creatorHandle + '#tip';
      head.appendChild(dm);
    }
    if (isAdmin) {
      var del = el('button', 'rmsg-del', '✕');
      del.type = 'button';
      del.setAttribute('data-id', m.id);
      del.title = 'Delete';
      head.appendChild(del);
    }
    wrap.appendChild(head);
    if (m.image) {
      var link = document.createElement('a');
      link.className = 'chat-img-link'; link.href = m.image; link.target = '_blank'; link.rel = 'noopener';
      var img = document.createElement('img');
      img.className = 'chat-img'; img.src = m.image; img.alt = 'shared picture'; img.loading = 'lazy';
      img.addEventListener('load', scrollIfNeeded);
      link.appendChild(img);
      wrap.appendChild(link);
    }
    if (m.body) wrap.appendChild(el('div', 'rmsg-body', m.body));
    box.appendChild(wrap);
    if (m.id > lastId) lastId = m.id;
  }

  async function poll() {
    try {
      var r = await fetch('/feed?after=' + lastId, { headers: { accept: 'application/json' } });
      var data = await r.json();
      if (data.messages && data.messages.length) { data.messages.forEach(addMessage); scrollIfNeeded(); }
    } catch (e) {}
  }
  setInterval(poll, 4000);

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    var body = input.value.trim();
    if (!body) return;
    var params = new URLSearchParams();
    params.set('body', body);
    if (nameInput) params.set('name', nameInput.value);
    input.value = '';
    try {
      var r = await fetch('/room', {
        method: 'POST',
        headers: { accept: 'application/json', 'content-type': 'application/x-www-form-urlencoded' },
        body: params,
      });
      var data = await r.json();
      if (data.ok && data.message) { atBottom = true; addMessage(data.message); scrollIfNeeded(); }
    } catch (e) {}
  });

  // Picture upload
  var photoBtn = document.getElementById('room-photo');
  var fileInput = document.getElementById('room-file');
  photoBtn.addEventListener('click', function () { fileInput.click(); });
  fileInput.addEventListener('change', async function () {
    var file = fileInput.files[0];
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) { alert('That image is too large (max 10 MB). Please pick a smaller one.'); fileInput.value = ''; return; }
    var fd = new FormData();
    fd.append('image', file);
    if (nameInput) fd.append('name', nameInput.value);
    photoBtn.disabled = true;
    var orig = photoBtn.textContent; photoBtn.textContent = '⏳';
    try {
      var r = await fetch('/room/upload', { method: 'POST', headers: { accept: 'application/json' }, body: fd });
      var text = await r.text();
      var data = null; try { data = JSON.parse(text); } catch (e) {}
      if (r.ok && data && data.ok && data.message) { atBottom = true; addMessage(data.message); scrollIfNeeded(); }
      else if (data && data.error) alert(data.error);
      else alert('Upload didn’t go through — please refresh the page and try again.');
    } catch (e) { alert('Upload didn’t go through — please refresh the page and try again.'); }
    photoBtn.disabled = false; photoBtn.textContent = orig;
    fileInput.value = '';
  });

  // Admin moderation: delete a message, or clear the whole room
  if (isAdmin) {
    box.addEventListener('click', async function (e) {
      var btn = e.target.closest('.rmsg-del');
      if (!btn) return;
      var id = btn.getAttribute('data-id');
      try {
        await fetch('/room/' + id + '/delete', { method: 'POST', headers: { accept: 'application/json' } });
        var node = box.querySelector('.rmsg[data-id="' + id + '"]');
        if (node) node.remove();
      } catch (e) {}
    });
    var clearBtn = document.getElementById('clear-room');
    if (clearBtn) clearBtn.addEventListener('click', async function () {
      if (!confirm('Clear the entire room? This deletes every message and picture for everyone.')) return;
      clearBtn.disabled = true;
      try {
        var r = await fetch('/room/clear', { method: 'POST', headers: { accept: 'application/json' } });
        if (r.ok) {
          var msgs = box.querySelectorAll('.rmsg');
          for (var i = 0; i < msgs.length; i++) msgs[i].remove();
          if (!document.getElementById('room-empty')) {
            var p = el('p', 'muted'); p.id = 'room-empty';
            p.textContent = 'No messages yet — be the first to say something 👋';
            box.appendChild(p); empty = p;
          }
        }
      } catch (e) {}
      clearBtn.disabled = false;
    });
  }
})();
</script>
