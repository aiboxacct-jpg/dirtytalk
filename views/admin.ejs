<h1>🛡 Admin</h1>
<p class="page-sub">Manage users, verification, and accounts.</p>
<% if (error) { %><div class="form-error"><%= error %></div><% } %>
<% var today = new Date().toISOString().slice(0, 10); %>

<div class="dash-grid">
  <div class="dash-card accent">
    <div class="dash-num"><%= '$' + ((stats.totalOwedCents || 0) / 100).toFixed(2) %></div>
    <div class="dash-label">Total owed to you</div>
  </div>
  <div class="dash-card">
    <div class="dash-num"><%= stats.totalSales %></div>
    <div class="dash-label">Sales logged</div>
  </div>
  <div class="dash-card">
    <div class="dash-num"><%= stats.creators %></div>
    <div class="dash-label">Creators<% if (stats.buyers) { %> · <%= stats.buyers %> buyers<% } %></div>
  </div>
  <div class="dash-card<% if (stats.lockedNow) { %> danger<% } %>">
    <div class="dash-num"><%= stats.lockedNow %></div>
    <div class="dash-label">Locked now<% if (stats.dueScheduled) { %> · <%= stats.dueScheduled %> due soon<% } %></div>
  </div>
</div>
<div class="fee-bar">
  <form action="/admin/fee" method="post" class="inline fee-form">
    <label for="fee">Site fee per sale: $</label>
    <input type="number" id="fee" name="fee" min="0" step="0.01" value="<%= (feeCents / 100).toFixed(2) %>" class="due-input" style="width:80px;">
    <button class="btn small" type="submit">Save fee</button>
  </form>
  <% if (stats.totalOwedCents) { %>
    <form action="/admin/clear-bill" method="post" class="inline" onsubmit="return confirm('Reset EVERY creator\'s bill to $0? This clears all outstanding site fees and cannot be undone.');">
      <input type="hidden" name="all" value="1">
      <button class="btn small muted" type="submit">↺ Reset all bills to $0</button>
    </form>
  <% } %>
</div>

<div class="card">
  <h2 style="margin-top:0;">Add a user</h2>
  <form action="/admin/add" method="post" class="add-user">
    <input type="text" name="name" placeholder="Display name" maxlength="30" required>
    <input type="email" name="email" placeholder="Email" required>
    <input type="password" name="password" placeholder="Password (6+ chars)" required>
    <button class="btn" type="submit">Add user</button>
  </form>
</div>

<div class="card table-wrap">
  <table class="admin-table">
    <thead>
      <tr><th>Name</th><th>Email</th><th>Verified</th><th>Bill</th><th>Due / lock</th><th>Joined</th><th></th></tr>
    </thead>
    <tbody>
      <% users.forEach(function(u){ %>
        <tr>
          <td>
            <a href="/u/<%= u.id %>"><%= u.name %></a>
            <% if (u.verified) { %><span class="verified" title="Verified">✔</span><% } %>
            <% if (u.id === adminId) { %><span class="tag">you</span><% } %>
          </td>
          <td class="mono"><%= u.email %></td>
          <td>
            <form action="/admin/verify" method="post" class="inline">
              <input type="hidden" name="user_id" value="<%= u.id %>">
              <input type="hidden" name="on" value="<%= u.verified ? '0' : '1' %>">
              <button class="btn small <%= u.verified ? 'muted' : '' %>" type="submit"><%= u.verified ? 'Unverify' : 'Verify' %></button>
            </form>
          </td>
          <td<% if (u.bill_cents) { %> class="bill-owed"<% } else { %> class="muted"<% } %>>
            <span class="bill-amt"><%= '$' + ((u.bill_cents || 0) / 100).toFixed(2) %><% if (u.sales_count) { %> <span class="muted">(<%= u.sales_count %>)</span><% } %></span>
            <% if (u.bill_cents) { %>
              <form action="/admin/clear-bill" method="post" class="inline" onsubmit="return confirm('Clear <%= u.name.replace(/'/g, "\\'") %>\'s bill to $0?');">
                <input type="hidden" name="user_id" value="<%= u.id %>">
                <button class="btn small muted" type="submit" title="Mark as paid — set bill to $0">Clear</button>
              </form>
            <% } %>
          </td>
          <td>
            <% var locked = u.due_date && today >= u.due_date; %>
            <% if (u.id === adminId) { %>
              <span class="muted">—</span>
            <% } else { %>
              <form action="/admin/due" method="post" class="due-form">
                <input type="hidden" name="user_id" value="<%= u.id %>">
                <input type="date" name="due_date" value="<%= u.due_date || '' %>" class="due-input">
                <button class="btn small" type="submit">Set</button>
                <% if (locked) { %><span class="tag locked-tag">LOCKED</span><% } %>
              </form>
            <% } %>
          </td>
          <td class="muted"><%= (u.created_at || '').slice(0, 10) %></td>
          <td class="row-actions">
            <% if (u.id !== adminId) { %>
              <form action="/admin/message" method="post" class="inline">
                <input type="hidden" name="user_id" value="<%= u.id %>">
                <button class="btn small" type="submit">💬 Message</button>
              </form>
              <form action="/admin/delete" method="post" class="inline" onsubmit="return confirm('Delete <%= u.name.replace(/'/g, "\\'") %> and all their private chats? This cannot be undone.');">
                <input type="hidden" name="user_id" value="<%= u.id %>">
                <button class="btn small danger" type="submit">Delete</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
