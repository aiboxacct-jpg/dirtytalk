<div class="card narrow">
  <h1>My account</h1>
  <p class="sub"><%= user.email %></p>
  <% if (error) { %><div class="form-error"><%= error %></div><% } %>

  <div class="acct-tabs">
    <div class="tab-bar" role="tablist">
      <button type="button" class="tab-btn active" data-tab="dash">📊 Dashboard</button>
      <button type="button" class="tab-btn" data-tab="bill">💵 Pay your bill</button>
    </div>

    <div class="tab-panel active" data-panel="dash">
      <div class="mini-cards">
        <div class="mini-card">
          <div class="mini-num"><%= user.sales_count || 0 %></div>
          <div class="mini-label">Sales logged</div>
        </div>
      </div>
      <p class="hint" style="margin:8px 0 2px;">Your revenue &amp; receipt history will show here soon.</p>
    </div>

    <div class="tab-panel" data-panel="bill">
      <div class="mini-cards">
        <div class="mini-card">
          <div class="mini-num">$1.00</div>
          <div class="mini-label">Fee per sale</div>
        </div>
        <div class="mini-card">
          <div class="mini-num"><%= '$' + ((user.bill_cents || 0) / 100).toFixed(2) %></div>
          <div class="mini-label">Current bill<% if (user.sales_count) { %> · <%= user.sales_count %><% } %></div>
        </div>
      </div>
      <% if (user.due_date) { %>
        <div class="due-warning">⚠ Payment due by <strong><%= user.due_date %></strong> — your account locks that day until it's paid.</div>
      <% } %>
      <p class="hint" style="margin:8px 0;">$1 per sale — a running tab you owe. Settle up anytime.</p>
      <a class="btn small cashapp-pay" href="https://cash.app/$<%= siteCashapp %>" target="_blank" rel="noopener noreferrer">💵 Pay on Cash App ($<%= siteCashapp %>)</a>
    </div>
  </div>

  <% var _slug = user.handle || user.id; %>
  <p class="hint">Your public profile & tip link:
    <a href="/u/<%= _slug %>" target="_blank" rel="noopener">/u/<%= _slug %></a></p>
  <%- include('partials/share', { shareUrl: absUrl('/u/' + _slug), shareTitle: user.name + ' — come chat with me on ' + siteName + ' 😘', label: 'Share your profile:' }) %>

  <div class="avatar-row">
    <span id="avatar-img" class="avatar-preview" <% if (user.avatar_url) { %>style="background-image:url('<%= user.avatar_url %>')"<% } %>><% if (!user.avatar_url) { %>📷<% } %></span>
    <div>
      <button type="button" class="btn small" id="avatar-btn">📷 Upload profile photo</button>
      <input type="file" id="avatar-file" accept="image/*" hidden>
      <p class="hint" style="margin:6px 0 0;">Shown on your public profile.</p>
    </div>
  </div>

  <form action="/account" method="post">
    <label for="name">Display name</label>
    <input type="text" id="name" name="name" maxlength="30" value="<%= user.name %>" required>

    <label for="bio">Bio (shown on your profile)</label>
    <textarea id="bio" name="bio" maxlength="500"><%= user.bio || '' %></textarea>

    <label>Gender</label>
    <div class="gender-pick">
      <label class="gpick"><input type="radio" name="gender" value="female" <%= user.gender === 'female' ? 'checked' : '' %>> <span class="gender female">♀</span> Female</label>
      <label class="gpick"><input type="radio" name="gender" value="male" <%= user.gender === 'male' ? 'checked' : '' %>> <span class="gender male">♂</span> Male</label>
      <label class="gpick"><input type="radio" name="gender" value="" <%= !user.gender ? 'checked' : '' %>> Skip</label>
    </div>

    <h2>Tip handles</h2>
    <p class="hint">People see these as tap-to-pay buttons on your profile and in private chats. Fill in the ones you use.</p>

    <label for="cashapp">Cash App ($cashtag)</label>
    <input type="text" id="cashapp" name="cashapp" value="<%= user.cashapp || '' %>" placeholder="$yourtag">

    <label for="venmo">Venmo (@username)</label>
    <input type="text" id="venmo" name="venmo" value="<%= user.venmo || '' %>" placeholder="@your-venmo">

    <label for="paypal">PayPal (email or PayPal.Me link)</label>
    <input type="text" id="paypal" name="paypal" value="<%= user.paypal || '' %>" placeholder="you@email.com or paypal.me/you">

    <label for="revolut">Revolut (@username or revolut.me link)</label>
    <input type="text" id="revolut" name="revolut" value="<%= user.revolut || '' %>" placeholder="@yourname or revolut.me/yourname">

    <label for="crypto">Crypto address (BTC, ETH, USDT…)</label>
    <input type="text" id="crypto" name="crypto" value="<%= user.crypto || '' %>" placeholder="your wallet address">

    <h2>Paid chat (tip to continue)</h2>
    <p class="hint">Give guests some free time in private chats, then pause them with your tip buttons until you tap “add time.” You unlock once you see the tip land. This is just the default — you can also flip paid time on/off live from inside any chat.</p>
    <label class="check">
      <input type="checkbox" name="paywall" value="1" <%= user.paywall_enabled ? 'checked' : '' %>>
      Ask for a tip to keep chatting
    </label>
    <label for="free_minutes">Free minutes before the tip prompt</label>
    <input type="number" id="free_minutes" name="free_minutes" min="1" max="120" step="1" value="<%= Math.round((user.free_seconds || 120) / 60) %>">

    <button class="btn" type="submit" style="width:100%;margin-top:16px;">Save changes</button>
  </form>
</div>

<script>
(function () {
  // Dashboard / Pay-your-bill tabs
  var tabBtns = document.querySelectorAll('.acct-tabs .tab-btn');
  var tabPanels = document.querySelectorAll('.acct-tabs .tab-panel');
  tabBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      var name = b.getAttribute('data-tab');
      tabBtns.forEach(function (x) { x.classList.toggle('active', x === b); });
      tabPanels.forEach(function (p) { p.classList.toggle('active', p.getAttribute('data-panel') === name); });
    });
  });
})();

(function () {
  var btn = document.getElementById('avatar-btn');
  var file = document.getElementById('avatar-file');
  var img = document.getElementById('avatar-img');
  if (!btn || !file) return;
  btn.addEventListener('click', function () { file.click(); });
  file.addEventListener('change', async function () {
    var f = file.files[0];
    if (!f) return;
    if (f.size > 10 * 1024 * 1024) { alert('That image is too large (max 10 MB).'); file.value = ''; return; }
    var fd = new FormData();
    fd.append('image', f);
    btn.disabled = true;
    var label = btn.textContent;
    btn.textContent = 'Uploading…';
    try {
      var r = await fetch('/account/avatar', { method: 'POST', headers: { accept: 'application/json' }, body: fd });
      var d = null; try { d = JSON.parse(await r.text()); } catch (e) {}
      if (r.ok && d && d.ok && d.url) { img.style.backgroundImage = "url('" + d.url + "')"; img.textContent = ''; }
      else alert((d && d.error) || 'Upload failed — please try again.');
    } catch (e) { alert('Upload failed — please try again.'); }
    btn.disabled = false;
    btn.textContent = label;
    file.value = '';
  });
})();
</script>
