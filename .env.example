# Copy to .env for local dev, or set these in Render's dashboard.

# Shown as the site name in the header and footer.
SITE_NAME=DirtyTalk

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Persistence (optional) -------------------------------------------------
# Leave BOTH unset to use the local on-disk SQLite file (data/chat.db).
# On Render's free tier the disk is wiped on each deploy, so for real use
# create a free Turso database and paste its URL + token here.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token
